{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build -w @tableflow/server",
  "outputDirectory": "server/dist",
  "framework": "node",
  "installCommand": "npm install",
  "devCommand": "npm run dev -w @tableflow/server",
  "regions": ["iad1"],
  "functions": {
    "server/dist/serverless.js": {
      "maxDuration": 30,
      "runtime": "nodejs22.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server/dist/serverless.js"
    },
    {
      "source": "/health",
      "destination": "/server/dist/serverless.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}