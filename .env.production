# Production environment variables for Vercel
# Copy these to Vercel Environment Variables in your project settings
NODE_ENV=production

# Update these with your actual values in Vercel:
# - MONGODB_URI (MongoDB Atlas connection string)
# - JWT_ACCESS_SECRET (unique, min 16 chars)
# - JWT_REFRESH_SECRET (unique, min 16 chars)
# - CLIENT_URL (your production domain)
