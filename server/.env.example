# Server Configuration
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tableflow_pos?retryWrites=true&w=majority

# JWT Secrets (Generate secure tokens for production)
JWT_ACCESS_SECRET=your-secret-key-at-least-16-characters
JWT_REFRESH_SECRET=your-refresh-secret-at-least-16-characters

# Token Expiry Settings
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
